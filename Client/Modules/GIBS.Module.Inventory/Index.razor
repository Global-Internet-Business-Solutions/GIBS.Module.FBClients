@namespace GIBS.Module.FBClients.Inventory
@inherits ModuleBase
@inject IStringLocalizer<Index> Localizer

<h3>@Localizer["Food Bank Inventory"]</h3>
@if (PageState.User?.IsAuthenticated == true)
{
    <nav class="d-flex flex-column gap-2 mb-3" aria-label="@Localizer["Inventory workflows"]">
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a class="btn btn-lg btn-primary" href="@NavigateUrl(ModuleState.ModuleId, nameof(Products))">@Localizer["Products"]</a>
            <a class="btn btn-lg btn-primary" href="@NavigateUrl(ModuleState.ModuleId, nameof(Invoices))">@Localizer["Invoices"]</a>

        </div>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a class="btn btn-sm btn-outline-primary" href="@NavigateUrl(ModuleState.ModuleId, nameof(Categories))">@Localizer["Product Categories"]</a>
            <a class="btn btn-sm btn-outline-primary" href="@NavigateUrl(ModuleState.ModuleId, nameof(Suppliers))">@Localizer["Suppliers"]</a>
            <a class="btn btn-sm btn-outline-primary" href="@NavigateUrl(ModuleState.ModuleId, nameof(FoodReport))">@Localizer["Food Inventory Report"]</a>
        </div>
    </nav>

    <p class="text-muted">@Localizer["Inventory Module ID: {0}", ModuleState.ModuleId]</p>
}
else
{
    <p>@Localizer["Sign in to access the inventory."]</p>
}
