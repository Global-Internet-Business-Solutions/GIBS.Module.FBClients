@namespace GIBS.Module.FBClients.Inventory
@using GIBS.Module.FBClients.Inventory.Services
@using Microsoft.AspNetCore.Components.Forms
@inherits InventoryPageBase
@inject IStringLocalizer<Categories> Localizer

<a href="@NavigateUrl()">@Localizer["Back to Inventory"]</a>
<h3>@Localizer["Product Categories"]</h3>
@if (_catalog != null)
{
    <div class="d-flex gap-3 align-items-center mb-3">
        @if (CanEdit)
        {
            <button type="button" class="btn btn-primary" disabled="@(Busy || _edit != null)" @onclick="() => _edit = new()">@Localizer["Add Category"]</button>
        }
        <label><input type="checkbox" @bind="_showInactive" /> @Localizer["Show inactive"]</label>
    </div>
    @if (_edit != null && CanEdit)
    {
        <EditForm Model="_edit" OnValidSubmit="SaveAsync" class="mb-4" @key="_edit.Id">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <fieldset disabled="@Busy">
                <legend>@Localizer[_edit.Id == 0 ? "New Category" : "Edit Category"]</legend>
                <label class="d-block mb-2">@Localizer["Category Name"] <InputText class="form-control" maxlength="50" @bind-Value="_edit.Name" /></label>
                <label class="d-block mb-2">@Localizer["Sort Order"] <InputNumber class="form-control" @bind-Value="_edit.SortOrder" /></label>
                <label class="d-block mb-2">@Localizer["Ordering Instructions"] <InputTextArea class="form-control" rows="4" @bind-Value="_edit.Instructions" /></label>
                <label class="d-block mb-3"><InputCheckbox @bind-Value="_edit.Active" /> @Localizer["Active"]</label>
                <button class="btn btn-primary" type="submit">@Localizer["Save Category"]</button>
                <button class="btn btn-secondary" type="button" @onclick="() => _edit = null">@Localizer["Cancel"]</button>
            </fieldset>
        </EditForm>
    }
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>@Localizer["Category"]</th><th>@Localizer["Sort Order"]</th><th>@Localizer["Status"]</th><th>@Localizer["Ordering Instructions"]</th>@if (CanEdit) { <th>@Localizer["Actions"]</th> }</tr></thead>
            <tbody>
                @foreach (var entry in _catalog.Categories.Where(x => _showInactive || x.Active))
                {
                    <tr @key="entry.Id">
                        <td>@DisplayName(entry.Name, entry.Id)</td><td>@entry.SortOrder</td><td>@Localizer[entry.Active ? "Active" : "Inactive"]</td>
                        <td class="text-break" style="white-space: pre-line">@entry.Instructions</td>
                        @if (CanEdit)
                        {
                            <td><button type="button" class="btn btn-sm btn-outline-primary" disabled="@(Busy || _edit != null)" @onclick="() => _edit = entry with { }">@Localizer["Edit"]</button></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Busy)
{
    <p role="status">@Localizer["Loading inventory..."]</p>
}

@code {
    private InventoryCatalog _catalog;
    private InventoryCategory _edit;
    private bool _showInactive;

    protected override Task OnInitializedAsync() => RunAsync(ReloadAsync);
    private async Task ReloadAsync() => _catalog = await Inventory.GetCatalogAsync(InventoryId);
    private Task SaveAsync() => RunAsync(async () =>
    {
        await Inventory.SaveCategoryAsync(InventoryId, _edit);
        _edit = null;
        await ReloadAsync();
    });
}
