@using GIBS.Module.FBClients.Lists.Services
@using GIBS.Module.FBClients.Lists.Models
@using ListEntry = GIBS.Module.FBClients.Lists.Models.Lists

@namespace GIBS.Module.FBClients.Lists
@inherits ModuleBase
@inject IListsService ClientListsService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer

@if (_Listss == null)
{
    <p><em>@Localizer["Message.Loading"]</em></p>
}
else
{
    <div class="row">
        <div class="col-md-3 mb-3">
            <select class="form-select" aria-label="@Localizer["ListName.Text"]" @bind="_selectedListKey" disabled="@_busy">
                <option value="">@Localizer["SelectList.Placeholder"]</option>
                @foreach (var group in _groups)
                {
                    <option value="@group.Key">@group.DisplayName</option>
                }
            </select>
            <div class="mt-3">
                <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Add List" ResourceKey="Add" />
            </div>
        </div>
        <div class="col-md-9">
            @if (SelectedGroup == null)
            {
                <p class="text-center text-muted">@Localizer["SelectList.Message"]</p>
            }
            else
            {
                <div class="row mb-4">
                    <div class="col-lg-7">
                        <div class="row mb-2 align-items-center">
                            <Oqtane.Modules.Controls.Label Class="col-sm-4 text-sm-end" For="listSummaryName" HelpText="@Localizer["ListName.HelpText"]">@Localizer["ListName.Text"]</Oqtane.Modules.Controls.Label>
                            <div id="listSummaryName" class="col-sm-8">@SelectedGroup.ListName</div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <Oqtane.Modules.Controls.Label Class="col-sm-4 text-sm-end" For="listSummaryParent" HelpText="@Localizer["Parent.HelpText"]">@Localizer["Parent.Text"]</Oqtane.Modules.Controls.Label>
                            <div id="listSummaryParent" class="col-sm-8">@SelectedParentText</div>
                        </div>
                        <div class="row align-items-center">
                            <Oqtane.Modules.Controls.Label Class="col-sm-4 text-sm-end" For="listSummaryTotal" HelpText="@Localizer["Total.HelpText"]">@Localizer["Total.Text"]</Oqtane.Modules.Controls.Label>
                            <div id="listSummaryTotal" class="col-sm-8">@Localizer[SelectedEntries.Count == 1 ? "Total.Entry" : "Total.Entries", SelectedEntries.Count]</div>
                        </div>
                    </div>
                </div>
                <div class="mb-2">
                    <ActionLink Action="Add" Parameters="@($"listName={Uri.EscapeDataString(SelectedGroup.ListName)}&parentId={SelectedGroup.ParentID}")" Security="SecurityAccessLevel.Edit" Text="Add List Entry" ResourceKey="AddListEntry" />
                    <ActionDialog @key="_selectedListKey" Header="@Localizer["DeleteList.Header"]" Message="@Localizer["DeleteList.Message"]" Text="@Localizer["DeleteList.Text"]" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger ms-1" Disabled="@_busy" OnClick="@(async () => await DeleteSelectedList())" ResourceKey="DeleteList" Id="@_selectedListKey" />
                </div>
                @if (SelectedEntries.Count == 0)
                {
                    <p>@Localizer["Message.DisplayNone"]</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>@Localizer["EntryText.Text"]</th>
                                    <th>@Localizer["EntryValue.Text"]</th>
                                    @if (SelectedGroup.EnableSortOrder)
                                    {
                                        <th class="text-center">@Localizer["MoveUp.Text"]</th>
                                        <th class="text-center">@Localizer["MoveDown.Text"]</th>
                                    }
                                    <th>@Localizer["Edit.Text"]</th>
                                    <th>@Localizer["Delete.Text"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var index = 0; index < SelectedEntries.Count; index++)
                                {
                                    var entry = SelectedEntries[index];
                                    var entryIndex = index;
                                    <tr @key="entry.ListsId">
                                        <td>@entry.Text</td>
                                        <td>@entry.Value</td>
                                        @if (SelectedGroup.EnableSortOrder)
                                        {
                                            <td class="text-center"><button type="button" class="btn btn-link p-0" aria-label="@Localizer["MoveUp.Text"]" disabled="@(_busy || !CanEdit || entryIndex == 0)" @onclick="() => MoveEntry(entry, -1)"><i class="oi oi-arrow-thick-top"></i></button></td>
                                            <td class="text-center"><button type="button" class="btn btn-link p-0" aria-label="@Localizer["MoveDown.Text"]" disabled="@(_busy || !CanEdit || entryIndex == SelectedEntries.Count - 1)" @onclick="() => MoveEntry(entry, 1)"><i class="oi oi-arrow-thick-bottom"></i></button></td>
                                        }
                                        <td><ActionLink Action="Edit" Parameters="@($"id={entry.ListsId}")" ResourceKey="Edit" /></td>
                                        <td><ActionDialog Header="@Localizer["DeleteEntry.Header"]" Message="@Localizer["DeleteEntry.Message"]" Text="@Localizer["DeleteEntry.Text"]" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" Disabled="@_busy" OnClick="@(async () => await DeleteEntry(entry))" ResourceKey="DeleteEntry" Id="@entry.ListsId.ToString()" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    public override string RenderMode => RenderModes.Interactive;

    private List<ListEntry> _Listss;
    private List<ListGroup> _groups = new();
    private string _selectedListKey;
    private bool _busy;
    private bool CanEdit => IsAuthorizedPermission(PermissionNames.Edit);
    private ListGroup SelectedGroup => _groups.FirstOrDefault(group => string.Equals(group.Key, _selectedListKey, StringComparison.OrdinalIgnoreCase));
    private List<ListEntry> SelectedEntries => SelectedGroup?.Entries ?? new List<ListEntry>();
    private string SelectedParentText => SelectedGroup?.ParentID > 0 ? SelectedGroup.ParentKey : Localizer["Parent.None"];

    private async Task ReloadLists()
    {
        _Listss = await ClientListsService.GetListssAsync(ModuleState.ModuleId)
            ?? throw new InvalidOperationException("Unable to load lists.");
        _groups = ListGroup.Create(_Listss);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadLists();
            if (PageState.QueryString.TryGetValue("listName", out var listName))
            {
                var parentId = PageState.QueryString.TryGetValue("parentId", out var parent) ? int.Parse(parent) : 0;
                _selectedListKey = _groups.FirstOrDefault(group => group.ParentID == parentId
                    && string.Equals(group.ListName, Uri.UnescapeDataString(listName), StringComparison.OrdinalIgnoreCase))?.Key;
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Lists {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    private async Task DeleteSelectedList()
    {
        if (_busy || SelectedGroup == null)
        {
            return;
        }

        try
        {
            _busy = true;
            await ClientListsService.DeleteListAsync(SelectedEntries.First().ListsId, ModuleState.ModuleId);
            await logger.LogInformation("Deleted Lists {ListKey}", _selectedListKey);
            await ReloadLists();
            _selectedListKey = null;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Lists {ListKey} {Error}", _selectedListKey, ex.Message);
            AddModuleMessage(Localizer["Message.DeleteError"], MessageType.Error);
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DeleteEntry(ListEntry entry)
    {
        if (_busy)
        {
            return;
        }

        try
        {
            _busy = true;
            await ClientListsService.DeleteListsAsync(entry.ListsId, ModuleState.ModuleId);
            await ReloadLists();
            await logger.LogInformation("Deleted List Entry {ListsId}", entry.ListsId);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting List Entry {ListsId} {Error}", entry.ListsId, ex.Message);
            AddModuleMessage(Localizer["Message.DeleteError"], MessageType.Error);
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MoveEntry(ListEntry entry, int direction)
    {
        var entries = SelectedEntries.ToList();
        var currentIndex = entries.FindIndex(item => item.ListsId == entry.ListsId);
        var targetIndex = currentIndex + direction;
        if (_busy || !CanEdit || SelectedGroup?.EnableSortOrder != true || currentIndex < 0 || targetIndex < 0 || targetIndex >= entries.Count)
        {
            return;
        }

        try
        {
            _busy = true;
            await ClientListsService.MoveListsAsync(entry.ListsId, direction, ModuleState.ModuleId);
            await ReloadLists();
            await logger.LogInformation("Reordered List Entry {ListsId}", entry.ListsId);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Reordering List Entry {ListsId} {Error}", entry.ListsId, ex.Message);
            AddModuleMessage(Localizer["Message.SaveError"], MessageType.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}