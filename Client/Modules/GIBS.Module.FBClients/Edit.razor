    // Map
    private string GetGoogleMapEmbedUrl()
    {
        if (_client.Latitude.HasValue && _client.Longitude.HasValue && (_client.Latitude.Value != 0 || _client.Longitude.Value != 0))
        {
            var lat = _client.Latitude.Value.ToString(CultureInfo.InvariantCulture);
            var lng = _client.Longitude.Value.ToString(CultureInfo.InvariantCulture);
            return $"https://maps.google.com/maps?q={lat},{lng}&z=15&output=embed";
        }
        if (!string.IsNullOrWhiteSpace(_client.ClientAddress))
        {
            var query = Uri.EscapeDataString($"{_client.ClientAddress}, {_client.ClientCity}, {_client.ClientState} {_client.ClientZipCode}");
            return $"https://maps.google.com/maps?q={query}&z=15&output=embed";
        }
        return string.Empty;
    }

