                                    {
                                        <span class="text-danger">@_xmasBikeNote</span>
                                    }
                                </div>
                            </div>

                            @if (_canDeleteRecord)
                            {
                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label fw-bold" for="txtBikeAwardedDate">Bike Awarded:</label>
                                    <div class="col-sm-9">
                                        <input id="txtBikeAwardedDate" type="date" class="form-control" @bind="_xmasBikeAwardedDateInput" />
                                    </div>
                                </div>
                            }

                            <div class="row mb-2 align-items-center">
                                <label class="col-sm-3 col-form-label fw-bold" for="txtReceivedToysDate">Received Toys:</label>
                                <div class="col-sm-9">
                                    <input id="txtReceivedToysDate" type="date" class="form-control" @bind="_xmasReceivedToysDateInput" />
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-3">
                                <button type="button" class="btn btn-success" @onclick="SaveChristmasRecord">Save Christmas Record</button>
                                <button type="button" class="btn btn-secondary" @onclick="CloseChristmasForm">Cancel</button>
                            </div>

                            @if (_afmChristmasHistory.Count > 0)
                            {
