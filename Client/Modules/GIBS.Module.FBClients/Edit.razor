    private string GetReturnToSearchUrl()
    {
        var queryParts = new List<string>();
        foreach (var key in new[] { "cidcard", "fname", "lname", "address", "clientid", "inactive" })
        {
            if (PageState.QueryString.TryGetValue(key, out var val) && !string.IsNullOrWhiteSpace(val))
            {
                queryParts.Add($"{key}={Uri.EscapeDataString(val)}");
            }
        }
        return queryParts.Count > 0
            ? NavigateUrl(PageState.Page.Path, string.Join("&", queryParts))
            : NavigateUrl();
    }
