                                    <table class="table table-sm table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Year</th>
                                                <th>Toys Verified</th>
                                                <th>Size</th>
                                                <th>Notes</th>
                                                <th>Gift 1</th>
                                                <th>Gift 1 Size</th>
                                                <th>Gift 2</th>
                                                <th>Gift 2 Size</th>
                                                <th>Bike Raffle</th>
                                                <th>Bike Awarded Date</th>
                                                <th>Updated By</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var hist in _afmChristmasHistory)
                                            {
                                                <tr>
                                                    <td>@hist.xMasYear</td>
                                                    <td>@(hist.VerifiedToys == true ? "Yes" : "No")</td>
                                                    <td>@hist.Sizes</td>
                                                    <td>@hist.XmasNotes</td>
                                                    <td>@hist.XmasGift1</td>
                                                    <td>@hist.XmasGift1Size</td>
                                                    <td>@hist.XmasGift2</td>
                                                    <td>@hist.XmasGift2Size</td>
                                                    <td>@(hist.BikeRaffle == true ? "Yes" : "No")</td>
                                                    <td>@(hist.BikeAwardedDate?.ToString("MM/dd/yyyy"))</td>
                                                    <td>@(string.IsNullOrEmpty(hist.ModifiedBy) ? hist.CreatedBy : hist.ModifiedBy)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }

                <Section Name="AFMFormSection" Heading="Additional Family Member" ResourceKey="SectionAFMForm" Expanded="true">
