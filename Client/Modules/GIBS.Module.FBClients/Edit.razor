    private void EditIncomeOrExpense(FBClientsIncomeAndExpense item)
    {
        ResetIncomeExpenseForm();
        _editingIeId = item.IeId;
        if (string.Equals(item.IeType, "IN", StringComparison.OrdinalIgnoreCase))
        {
            if (!_incomeOptions.Contains(item.IeDescription, StringComparer.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.IeDescription))
            {
                _incomeOptions.Add(item.IeDescription);
            }
            _incomeSource = item.IeDescription ?? string.Empty;
            _incomeAmountInput = item.IeAmount;
        }
        else
        {
            if (!_expenseOptions.Contains(item.IeDescription, StringComparer.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.IeDescription))
            {
                _expenseOptions.Add(item.IeDescription);
            }
            _expenseSource = item.IeDescription ?? string.Empty;
            _expenseAmountInput = item.IeAmount;
        }
    }

    private async Task SaveIncomeExpense()
    {
        try
        {
            bool savedAny = false;
            if (!string.IsNullOrWhiteSpace(_incomeSource) && _incomeAmountInput.HasValue)
            {
                var incRecord = new FBClientsIncomeAndExpense
                {
                    IeId = _editingIeId,
                    FBClientsId = _id,
                    IeType = "IN",
                    IeDescription = _incomeSource,
                    IeAmount = _incomeAmountInput.Value
                };
                if (_editingIeId > 0)
                {
                    await ClientFBClientsService.UpdateFBClientsIncomeAndExpenseAsync(incRecord, ModuleState.ModuleId);
                }
                else
                {
                    await ClientFBClientsService.AddFBClientsIncomeAndExpenseAsync(incRecord, ModuleState.ModuleId);
                }
                savedAny = true;
            }

            if (_settings.ShowExpense && !string.IsNullOrWhiteSpace(_expenseSource) && _expenseAmountInput.HasValue)
            {
                var expRecord = new FBClientsIncomeAndExpense
                {
                    IeId = _editingIeId,
                    FBClientsId = _id,
                    IeType = "EX",
                    IeDescription = _expenseSource,
                    IeAmount = _expenseAmountInput.Value
                };
                if (_editingIeId > 0)
                {
                    await ClientFBClientsService.UpdateFBClientsIncomeAndExpenseAsync(expRecord, ModuleState.ModuleId);
                }
                else
                {
                    await ClientFBClientsService.AddFBClientsIncomeAndExpenseAsync(expRecord, ModuleState.ModuleId);
                }
                savedAny = true;
            }

            if (!savedAny)
            {
                AddModuleMessage("Please select a source and enter an amount.", MessageType.Warning);
                return;
            }

            _incomeAndExpenses = await ClientFBClientsService.GetFBClientsIncomeAndExpensesAsync(_id, ModuleState.ModuleId) ?? new();
            RecalculateHeaderAndValidation();
            ResetIncomeExpenseForm();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving Income/Expense {Error}", ex.Message);
            AddModuleMessage("Error saving income/expense item.", MessageType.Error);
        }
    }

