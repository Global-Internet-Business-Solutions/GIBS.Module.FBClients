                            @if (_settings.ShowRelationshipToClient)
                            {
                                <div class="row mb-2 align-items-center">
                                    <Label Class="col-sm-3" For="ddlAFMRelationship" HelpText="Select Relationship to Client" ResourceKey="lblAFMRelationship">Relationship to Client:</Label>
                                    <div class="col-sm-9">
                                        <select id="ddlAFMRelationship" class="form-select" @bind="_editingAfm.AFMRelationship" required="@_settings.ReqAFMRelationship">
                                            <option value="">Select</option>
                                            @foreach (var rel in _relationshipOptions)
                                            {
                                                <option value="@rel">@rel</option>
                                            }
                                        </select>
                                    </div>
                                </div>
