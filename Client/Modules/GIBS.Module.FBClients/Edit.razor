    private async Task SaveClient()
    {
        try
        {
            _clientValidated = true;
            var interop = new Oqtane.UI.Interop(JSRuntime);
            if (!await interop.FormValid(_clientForm))
            {
                AddModuleMessage(Localizer["Message.SaveValidation"], MessageType.Warning);
                return;
            }

            // Normalize uppercased fields as in DNN EditClient.ascx.cs
            _client.ClientFirstName = _client.ClientFirstName?.Trim().ToUpperInvariant();
            _client.ClientMiddleInitial = _client.ClientMiddleInitial?.Trim().ToUpperInvariant();
            _client.ClientLastName = _client.ClientLastName?.Trim().ToUpperInvariant();
            _client.ClientAddress = _client.ClientAddress?.Trim().ToUpperInvariant();
            _client.ClientUnit = _client.ClientUnit?.Trim().ToUpperInvariant();
            _client.ClientCity = _client.ClientCity?.Trim();
            _client.ClientTown = _client.ClientTown?.Trim();
            _client.ClientState = _client.ClientState?.Trim().ToUpperInvariant();
            _client.ClientZipCode = _client.ClientZipCode?.Trim();
            _client.PrimaryIncomeSource ??= string.Empty;
            _client.Disability = string.Join(", ", _selectedDisabilities);

            if (_id <= 0)
            {
                _client.ModuleId = ModuleState.ModuleId;
                _client = await ClientFBClientsService.AddFBClientsAsync(_client);
                _id = _client.FBClientsId;
                await SaveTrueFalseQuestionsAsync(_id);
                await logger.LogInformation("FBClients Added {FBClientsId}", _client.FBClientsId);
                await LoadClientAndRelatedDataAsync();
                _activeTab = "AFM";
                AddModuleMessage("Client record created. You may now add Household Members, Income/Expenses, and Visits.", MessageType.Success);
            }
            else
            {
                _client = await ClientFBClientsService.UpdateFBClientsAsync(_client);
                await SaveTrueFalseQuestionsAsync(_id);
                await logger.LogInformation("FBClients Updated {FBClientsId}", _client.FBClientsId);
                await LoadClientAndRelatedDataAsync();
                AddModuleMessage("Client record updated successfully.", MessageType.Success);
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving FBClients {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.SaveError"], MessageType.Error);
        }
    }

    private async Task SaveTrueFalseQuestionsAsync(int clientId)
    {
        foreach (var q in _trueFalseQuestionOptions)
        {
            var answer = GetTfAnswer(q);
            if (answer || _tfQuestions.Any(x => string.Equals(x.TfQuestion, q, StringComparison.OrdinalIgnoreCase)))
            {
                await ClientFBClientsService.SaveFBClientsTrueFalseQuestionAsync(new FBClientsTrueFalseQuestions
                {
                    FBClientsId = clientId,
                    TfQuestion = q,
                    TfAnswer = answer
                }, ModuleState.ModuleId);
            }
        }
    }

