                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="ddlAFMGender" HelpText="Select Gender" ResourceKey="lblAFMGender">Gender:</Label>
                                <div class="col-sm-9">
                                    <select id="ddlAFMGender" class="form-select" @bind="_editingAfm.AFMGender" required="@_settings.ReqGender">
                                        <option value="">Select</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Non-Label">Non-Labeling</option>
                                        <option value="NoAnswer">Prefers Not To Answer</option>
                                    </select>
                                </div>
                            </div>

                            @if (_settings.ShowEthnicity)
                            {
                                <div class="row mb-2 align-items-center">
                                    <Label Class="col-sm-3" For="ddlAFMEthnicity" HelpText="Select Ethnicity" ResourceKey="lblAFMEthnicity">Ethnicity:</Label>
                                    <div class="col-sm-9">
                                        <select id="ddlAFMEthnicity" class="form-select" @bind="_editingAfm.AFMEthnicity" required="@_settings.ReqEthnicity">
                                            <option value=""></option>
                                            @foreach (var eth in _ethnicityOptions)
                                            {
                                                <option value="@eth">@eth</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            }
                        </div>
                    </form>
                </Section>
            }
        </TabPanel>

        <TabPanel Name="IncomeExpense" Heading="@(_settings.ShowExpense ? "Income & Expense" : "Income")" ResourceKey="TabIncomeExpense">
            @if (_id <= 0)
            {
                <div class="alert alert-info">Please save the client record on the Client tab before entering income or expenses.</div>
            }
            else
            {
                <div class="container mb-3">
                    <div class="row mb-2 align-items-center">
                        <Label Class="col-sm-3" For="ddlClientIncome" HelpText="Select Monthly Income Source" ResourceKey="lblClientIncome">Monthly Income:</Label>
                        <div class="col-sm-4">
                            <select id="ddlClientIncome" class="form-select" @bind="_incomeSource">
                                <option value="">Select Income Source</option>
                                @foreach (var inc in _incomeOptions)
                                {
                                    <option value="@inc">@inc</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <input id="txtIeAmount" type="number" step="0.01" class="form-control" placeholder="Amount" @bind="_incomeAmountInput" />
                        </div>
                        <div class="col-sm-2">
                            <button type="button" class="btn btn-primary w-100" @onclick="SaveIncomeExpense">Save/Update</button>
                        </div>
                    </div>

                    @if (_settings.ShowExpense)
                    {
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="ddlClientExpense" HelpText="Select Monthly Expense" ResourceKey="lblClientExpense">Monthly Expense:</Label>
                            <div class="col-sm-4">
                                <select id="ddlClientExpense" class="form-select" @bind="_expenseSource">
                                    <option value="">Select Expense</option>
                                    @foreach (var exp in _expenseOptions)
                                    {
                                        <option value="@exp">@exp</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-3">
                                <input id="txtIeExpenseAmount" type="number" step="0.01" class="form-control" placeholder="Amount" @bind="_expenseAmountInput" />
                            </div>
                            <div class="col-sm-2">
                                @if (_editingIeId > 0)
                                {
                                    <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetIncomeExpenseForm">Cancel Edit</button>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="row mb-3">
                    <div class="@(_settings.ShowExpense ? "col-md-6" : "col-md-12")">
                        <h6>Monthly Income</h6>
                        <table class="table table-striped table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>Edit</th>
                                    <th>Delete</th>
                                    <th>Source</th>
                                    <th class="text-end">Amount</th>
                                    <th>Updated By</th>
                                    <th>Updated On</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inc in _incomeAndExpenses.Where(x => string.Equals(x.IeType, "IN", StringComparison.OrdinalIgnoreCase)))
                                {
                                    <tr>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="@(() => EditIncomeOrExpense(inc))">Edit</button>
                                        </td>
                                        <td>
                                            <ActionDialog Header="Delete Income" Message="Are you sure you want to delete this income item?" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-sm btn-outline-danger" OnClick="@(async () => await DeleteIncomeOrExpense(inc.IeId))" />
                                        </td>
                                        <td>@inc.IeDescription</td>
                                        <td class="text-end">@((inc.IeAmount ?? 0m).ToString("C", CultureInfo.CurrentCulture))</td>
                                        <td>@(string.IsNullOrEmpty(inc.ModifiedBy) ? inc.CreatedBy : inc.ModifiedBy)</td>
                                        <td>@((inc.LegacyLastModifiedOnDate ?? inc.ModifiedOn).ToString("MM/dd/yyyy"))</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="3" class="text-end">Total Monthly Income:</td>
                                    <td class="text-end">@_totalMonthlyIncome.ToString("C", CultureInfo.CurrentCulture)</td>
                                    <td colspan="2"></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td colspan="3" class="text-end">Total Annual Income:</td>
                                    <td class="text-end">@((_totalMonthlyIncome * 12m).ToString("C", CultureInfo.CurrentCulture))</td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    @if (_settings.ShowExpense)
                    {
                        <div class="col-md-6">
                            <h6>Monthly Expenses</h6>
                            <table class="table table-striped table-bordered align-middle">
                                <thead>
                                    <tr>
                                        <th>Edit</th>
                                        <th>Delete</th>
                                        <th>Expense</th>
                                        <th class="text-end">Amount</th>
                                        <th>Updated By</th>
                                        <th>Updated On</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var exp in _incomeAndExpenses.Where(x => string.Equals(x.IeType, "EX", StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <tr>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="@(() => EditIncomeOrExpense(exp))">Edit</button>
                                            </td>
                                            <td>
                                                <ActionDialog Header="Delete Expense" Message="Are you sure you want to delete this expense item?" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-sm btn-outline-danger" OnClick="@(async () => await DeleteIncomeOrExpense(exp.IeId))" />
                                            </td>
                                            <td>@exp.IeDescription</td>
                                            <td class="text-end">@((exp.IeAmount ?? 0m).ToString("C", CultureInfo.CurrentCulture))</td>
                                            <td>@(string.IsNullOrEmpty(exp.ModifiedBy) ? exp.CreatedBy : exp.ModifiedBy)</td>
                                            <td>@((exp.LegacyLastModifiedOnDate ?? exp.ModifiedOn).ToString("MM/dd/yyyy"))</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold">
                                        <td colspan="3" class="text-end">Total Monthly Expenses:</td>
                                        <td class="text-end">@_totalMonthlyExpenses.ToString("C", CultureInfo.CurrentCulture)</td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_settings.IncomeEligibilityGuidelines))
                {
                    <Section Name="GuidelinesSection" Heading="Click Here for Income Eligibility Guidelines" ResourceKey="SectionGuidelines" Expanded="false">
                        <div class="p-2">
                            @((MarkupString)_settings.IncomeEligibilityGuidelines)
                        </div>
                    </Section>
                }
            }
        </TabPanel>

        <TabPanel Name="Map" Heading="Map" ResourceKey="TabMap">
            @if (_id <= 0)
            {
                <div class="alert alert-info">Please save the client record on the Client tab before viewing or saving map coordinates.</div>
            }
            else
            {
                <div class="container">
                    <div class="row mb-3 align-items-center">
                        <Label Class="col-sm-2" For="txtLatitude" HelpText="Latitude (decimal 10,5)" ResourceKey="lblLatitude">Latitude:</Label>
                        <div class="col-sm-3">
                            <input id="txtLatitude" type="number" step="0.00001" class="form-control" @bind="_client.Latitude" />
                        </div>
                        <Label Class="col-sm-2" For="txtLongitude" HelpText="Longitude (decimal 10,5)" ResourceKey="lblLongitude">Longitude:</Label>
                        <div class="col-sm-3">
                            <input id="txtLongitude" type="number" step="0.00001" class="form-control" @bind="_client.Longitude" />
                        </div>
                        <div class="col-sm-2">
                            <button type="button" class="btn btn-primary w-100" @onclick="SaveMapCoordinates">Save Map</button>
                        </div>
                    </div>

