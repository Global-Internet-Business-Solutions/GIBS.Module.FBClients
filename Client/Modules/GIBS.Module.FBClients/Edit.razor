                            <select id="ddlVisitNumBags" class="form-select" @bind="_visitNumBagsString">
                                @for (int b = 0; b <= 15; b++)
                                {
                                    var bagVal = b.ToString();
                                    <option value="@bagVal">@bagVal</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (string.Equals(_client.ClientType, "Pallet", StringComparison.OrdinalIgnoreCase) && _editingVisit.VisitId == 0)
                    {
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="ddlRepeatInsert" HelpText="Number of pallet visits to insert" ResourceKey="lblRepeatInsert">Repeat Insert (x) Times:</Label>
                            <div class="col-sm-9">
                                <select id="ddlRepeatInsert" class="form-select" @bind="_repeatInsertCount">
                                    @for (int r = 1; r <= 20; r++)
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }

                    <div class="row mb-2 align-items-center">
                        <Label Class="col-sm-3" For="txtVisitNotes" HelpText="Visit Notes" ResourceKey="lblVisitNotes">Notes:</Label>
                        <div class="col-sm-9">
                            <textarea id="txtVisitNotes" class="form-control" rows="2" maxlength="800" @bind="_editingVisit.VisitNotes"></textarea>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Edit</th>
                                @if (_canDeleteRecord)
                                {
                                    <th>Delete</th>
                                }
                                <th>Visit Date</th>
                                <th>Bags</th>
                                <th>Notes</th>
                                <th>Location</th>
                                <th>Signature</th>
                                <th>Status</th>
                                <th>Created By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_visits.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted">No visits recorded for this client.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var visit in _visits)
                                {
                                    <tr>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="@(() => EditVisit(visit))">Edit</button>
                                        </td>
                                        @if (_canDeleteRecord)
                                        {
                                            <td>
                                                <ActionDialog Header="Delete Visit" Message="Are you sure you want to delete this visit?" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-sm btn-outline-danger" OnClick="@(async () => await DeleteVisit(visit.VisitId))" />
                                            </td>
                                        }
                                        <td>@visit.VisitDate.ToString("MM/dd/yyyy")</td>
                                        <td>@(visit.VisitNumBags ?? 0)</td>
                                        <td>@visit.VisitNotes</td>
                                        <td>@visit.ServiceLocation</td>
                                        <td>
                                            @if (visit.ClientSignature != null && visit.ClientSignature.Length > 0)
                                            {
                                                <img src="@($"data:image/png;base64,{Convert.ToBase64String(visit.ClientSignature)}")" alt="Signature" class="sigZoom" />
                                            }
                                        </td>
                                        <td>@GetOrderStatusLabel(visit.OrderStatusCode)</td>
                                        <td>@(string.IsNullOrEmpty(visit.ModifiedBy) ? visit.CreatedBy : visit.ModifiedBy)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </TabPanel>
    </TabStrip>
}

