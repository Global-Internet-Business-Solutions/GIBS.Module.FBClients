@using Oqtane.Modules.Controls
@using GIBS.Module.FBClients.Services
@using GIBS.Module.FBClients.Models
@using System.Globalization

@namespace GIBS.Module.FBClients
@inherits ModuleBase
@inject IFBClientsService ClientFBClientsService
@inject ISettingService SettingService
@inject IUserRoleService UserRoleService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Edit> Localizer

@if (_initialized)
{
    @if (_id > 0)
    {
        <div class="row mb-2 border rounded bg-light p-2 align-items-center">
            <div class="col-md-5 ClientNameHeader">
                @if (_settings.ShowPhotoID)
                {
                    <div class="mb-1">
                        <a class="btn btn-sm btn-outline-primary" href="@EditUrl("Camera", $"id={_id}")">Manage PhotoID</a>
                    </div>
                }
                <div>@GetClientHeaderBlock()</div>
                <div class="text-danger">Client ID: @(_client.LegacyClientId ?? _client.FBClientsId)</div>
            </div>
            <div class="col-md-2 text-center">
                @if (!string.IsNullOrEmpty(_clientPhotoDataUrl))
                {
                    <img src="@_clientPhotoDataUrl" alt="Client Photo" height="100" class="hover-zoom rounded border" />
                }
            </div>
            <div class="col-md-5 ClientNameHeaderRight">
                <div class="text-primary">Qualifies for @_qualifiesForBags Bag(s)</div>
                <div>
                    @if (_settings.ShowVisitStopLight)
                    {
                        if (_visitEligible)
                        {
                            <span class="badge bg-success me-1" title="Eligible for Visit">&#9679; GO</span>
                        }
                        else
                        {
                            <span class="badge bg-danger me-1" title="Visit Window Not Met">&#9679; STOP</span>
                        }
                    }
                    <span>@_lastVisitSummary</span>
                </div>
                <div>Total in Household: @_householdTotal</div>
                <div class="fs-6">@_ageGroupsSummary</div>
                @if (_settings.ShowIncExpSummary)
                {
                    <div class="@(_netIncomeExpense >= 0 ? "text-success" : "text-danger")">
                        +/- Inc &amp; Exp: @_netIncomeExpense.ToString("C", CultureInfo.CurrentCulture)
                    </div>
                }
                <div class="mt-2">
                    @if (_settings.ShowPrintShoppingLabel)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm me-1" @onclick="PrintShoppingLabel">Print Shopping Label</button>
                    }
                    @if (_settings.ShowPrintBarCodeLabel)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PrintBarcodeLabel">Print Barcode Label</button>
                    }
                </div>
            </div>
            @if (_client.SubjectToReview || !string.IsNullOrWhiteSpace(_client.ClientNote))
            {
                <div class="col-12 ClientNotesQuickView">
                    @if (_client.SubjectToReview)
                    {
                        <span class="badge bg-danger me-2">FLAGGED FOR REVIEW</span>
                    }
                    <span>@_client.ClientNote</span>
                </div>
            }
        </div>
    }

    @if (_verificationAlerts.Count > 0)
    {
        <div class="alert @(_id > 0 ? "alert-warning" : "alert-info") mb-3">
            @foreach (var alert in _verificationAlerts)
            {
                <div>@alert</div>
            }
        </div>
    }

    <TabStrip ActiveTab="@_activeTab" Refresh="true">
        <TabPanel Name="Client" Heading="Client" ResourceKey="TabClient">
            <form @ref="_clientForm" class="@(_clientValidated ? "was-validated" : "needs-validation")" novalidate>
                <div class="d-flex justify-content-end gap-2 mb-3">
                    <button type="button" class="btn btn-primary" @onclick="SaveClient">@Localizer["Save"]</button>
                    @if (_id > 0 && _canDeleteRecord)
                    {
                        <ActionDialog Header="Delete Client" Message="Are You Sure You Wish To Permanently Delete This Client?" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" OnClick="@(async () => await DeleteClient())" ResourceKey="DeleteClient" />
                        <a class="btn btn-secondary" href="@EditUrl("ClientMerge", $"id={_id}")">@Localizer["Merge"]</a>
                    }
                    <NavLink class="btn btn-outline-secondary" href="@GetReturnToSearchUrl()">@Localizer["Cancel"]</NavLink>
                </div>

                <Section Name="DemographicsSection" Heading="Client Name & Demographics" ResourceKey="SectionDemographics" Expanded="true">
                    <div class="container">
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="ddlIsActive" HelpText="Set Client Active or Inactive" ResourceKey="lblIsActive">Status:</Label>
                            <div class="col-sm-9">
                                <select id="ddlIsActive" class="form-select" @bind="_isActiveString">
                                    <option value="True">Active</option>
                                    <option value="False">InActive</option>
                                </select>
                            </div>
                        </div>

                        @if (_settings.ShowClientType)
                        {
                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="ddlClientType" HelpText="Select the Client Type" ResourceKey="lblClientType">Client Type:</Label>
                                <div class="col-sm-9">
                                    <select id="ddlClientType" class="form-select" value="@(_client.ClientType ?? "Individual")" @onchange="OnClientTypeChanged">
                                        @foreach (var clientType in _clientTypeOptions)
                                        {
                                            <option value="@clientType">@clientType</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }

                        @if (_settings.ShowClientServiceLocation)
                        {
                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="ddlClientServiceLocation" HelpText="Where the client originated" ResourceKey="lblClientServiceLocation">Client Origination:</Label>
                                <div class="col-sm-9">
                                    <select id="ddlClientServiceLocation" class="form-select" @bind="_client.ServiceLocation">
                                        @foreach (var loc in _serviceLocationOptions)
                                        {
                                            <option value="@loc">@loc</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="txtClientFirstName" HelpText="Enter Client First Name" ResourceKey="lblClientFirstName">First Name:</Label>
                            <div class="col-sm-9">
                                <input id="txtClientFirstName" class="form-control" maxlength="30" @bind="_client.ClientFirstName" disabled="@IsGroupOrPalletClient" required="@IsFirstNameRequired" />
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="txtClientMiddleInitial" HelpText="Enter Client Middle Name or Initial" ResourceKey="lblClientMiddleInitial">Middle Name:</Label>
                            <div class="col-sm-9">
                                <input id="txtClientMiddleInitial" class="form-control" maxlength="30" @bind="_client.ClientMiddleInitial" disabled="@IsGroupOrPalletClient" />
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="txtClientLastName" HelpText="Enter Client Last Name" ResourceKey="lblClientLastName">@GetLastNameLabel()</Label>
                            <div class="col-sm-9">
                                <input id="txtClientLastName" class="form-control" maxlength="30" @bind="_client.ClientLastName" required />
                            </div>
                        </div>

                        @if (_settings.ShowSuffix)
                        {
                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="ddlClientSuffix" HelpText="Select Client Suffix" ResourceKey="lblClientSuffix">Suffix:</Label>
                                <div class="col-sm-9">
                                    <select id="ddlClientSuffix" class="form-select" @bind="_client.ClientSuffix">
                                        <option value=""></option>
                                        @foreach (var suffix in _suffixOptions)
                                        {
                                            <option value="@suffix">@suffix</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="txtClientDOB" HelpText="Enter Client Birth Date" ResourceKey="lblClientDOB">Birth Date:</Label>
                            <div class="col-sm-9">
                                <input id="txtClientDOB" type="date" class="form-control" @bind="_clientDobInput" disabled="@IsGroupOrPalletClient" required="@IsDobRequired" />
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="ddlClientGender" HelpText="Select Client Gender" ResourceKey="lblClientGender">Gender:</Label>
                            <div class="col-sm-9">
                                <select id="ddlClientGender" class="form-select" @bind="_client.ClientGender" required="@IsGenderRequired">
                                    <option value="">----</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Non-Label">Non-Labeling</option>
                                    <option value="NoAnswer">Prefers Not To Answer</option>
                                </select>
                            </div>
                        </div>

                        @if (_settings.ShowEthnicity)
                        {
                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="ddlEthnicity" HelpText="Select Client Ethnicity" ResourceKey="lblEthnicity">Ethnicity:</Label>
                                <div class="col-sm-9">
                                    <select id="ddlEthnicity" class="form-select" @bind="_client.ClientEthnicity" required="@IsEthnicityRequired">
                                        <option value=""></option>
                                        @foreach (var eth in _ethnicityOptions)
                                        {
                                            <option value="@eth">@eth</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="ddlClientLanguage" HelpText="Select Preferred Language" ResourceKey="lblClientLanguage">Preferred Language:</Label>
                            <div class="col-sm-9">
                                <select id="ddlClientLanguage" class="form-select" @bind="_client.ClientLanguage" required="@_settings.ShowRequiredFields">
                                    <option value=""></option>
                                    @foreach (var lang in _languageOptions)
                                    {
                                        <option value="@lang.Key">@lang.Value</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="txtVerifyDate" HelpText="Date Client Identity & DOB were verified" ResourceKey="lblVerifyDate">Client Verified Date:</Label>
                            <div class="col-sm-5">
                                <div class="input-group">
                                    <input id="txtVerifyDate" type="date" class="form-control" @bind="_clientVerifyDateInput" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="SetClientVerifiedToday">Today</button>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-check">
                                    <input id="cbxClientDOBVerify" type="checkbox" class="form-check-input" @bind="_client.ClientDOBVerify" />
                                    <label class="form-check-label" for="cbxClientDOBVerify">@Localizer["lblClientDOBVerify.Text"]</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </Section>

                <Section Name="AddressSection" Heading="Address, E-Mail & Phone" ResourceKey="SectionAddress" Expanded="true">
                    <div class="container">
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="txtClientAddress" HelpText="Street Number and Street Name ONLY! Use the Apt./Unit input below for apartments, units, suites, room #'s, etc." ResourceKey="lblClientAddress">Address:</Label>
                            <div class="col-sm-9">
                                <input id="txtClientAddress" class="form-control" maxlength="50" @bind="_client.ClientAddress" required />
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="txtClientUnit" HelpText="Apartment, Unit, Suite or Room Number" ResourceKey="lblClientUnit">Apt./Unit:</Label>
                            <div class="col-sm-9">
                                <input id="txtClientUnit" class="form-control" maxlength="20" @bind="_client.ClientUnit" />
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="ddlClientCity" HelpText="Select Town" ResourceKey="lblClientCity">Town:</Label>
                            <div class="col-sm-9">
                                <select id="ddlClientCity" class="form-select" value="@(_client.ClientCity ?? string.Empty)" @onchange="OnClientCityChanged" required>
                                    <option value="">Select Town</option>
                                    @foreach (var town in _townOptions)
                                    {
                                        <option value="@town">@town</option>
                                    }
                                    <option value="OTHER">OTHER</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="ddlClientTown" HelpText="Select Village" ResourceKey="lblClientTown">Village:</Label>
                            <div class="col-sm-9">
                                @if (string.Equals(_client.ClientCity, "OTHER", StringComparison.OrdinalIgnoreCase))
                                {
                                    <input id="txtClientTown" class="form-control" maxlength="20" @bind="_client.ClientTown" placeholder="Enter Town/Village" />
                                }
                                else
                                {
                                    <select id="ddlClientTown" class="form-select" @bind="_client.ClientTown">
                                        <option value=""></option>
                                        @foreach (var village in GetVillageOptionsForCity(_client.ClientCity))
                                        {
                                            <option value="@village">@village</option>
                                        }
                                    </select>
                                }
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="ddlClientState" HelpText="Select State" ResourceKey="lblClientState">State:</Label>
                            <div class="col-sm-9">
                                <input id="ddlClientState" class="form-control" maxlength="20" @bind="_client.ClientState" />
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="txtClientZipCode" HelpText="Enter 5-digit or 9-digit Zip Code" ResourceKey="lblClientZipCode">Zip Code:</Label>
                            <div class="col-sm-9">
                                <input id="txtClientZipCode" class="form-control" maxlength="10" @bind="_client.ClientZipCode" required="@_settings.ReqZipCode" />
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="txtClientAddressVerifyDate" HelpText="Date Client Address was verified" ResourceKey="lblClientAddressVerify">Address Verified:</Label>
                            <div class="col-sm-5">
                                <div class="input-group">
                                    <input id="txtClientAddressVerifyDate" type="date" class="form-control" @bind="_clientAddressVerifyDateInput" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="SetAddressVerifiedToday">Today</button>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-check">
                                    <input id="cbxClientAddressVerify" type="checkbox" class="form-check-input" @bind="_client.ClientAddressVerify" />
                                    <label class="form-check-label" for="cbxClientAddressVerify">Address Verified</label>
                                </div>
                            </div>
                        </div>

                        @if (_settings.ShowOneBagOnly)
                        {
                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="cbxOneBagOnly" HelpText="Restrict client to 1 bag regardless of household size" ResourceKey="lblOneBagOnly">One Bag Client:</Label>
                                <div class="col-sm-9">
                                    <input id="cbxOneBagOnly" type="checkbox" class="form-check-input" @bind="_client.OneBagOnly" />
                                </div>
                            </div>
                        }

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="txtClientEmailAddress" HelpText="Enter Client E-Mail Address" ResourceKey="lblClientEmailAddress">E-Mail Address:</Label>
                            <div class="col-sm-9">
                                <input id="txtClientEmailAddress" type="email" class="form-control" maxlength="50" @bind="_client.ClientEmailAddress" />
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="txtClientPhone" HelpText="Enter Client Phone Number" ResourceKey="lblClientPhone">Phone Number:</Label>
                            <div class="col-sm-5">
                                <input id="txtClientPhone" class="form-control" maxlength="25" @bind="_client.ClientPhone" />
                            </div>
                            <div class="col-sm-4">
                                <select id="ddlClientPhoneType" class="form-select" @bind="_client.ClientPhoneType">
                                    <option value="">-- Type --</option>
                                    <option value="Home">Home</option>
                                    <option value="Cell">Cell</option>
                                    <option value="Work">Work</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </Section>

                <Section Name="OtherSection" Heading="Other" ResourceKey="SectionOther" Expanded="true">
                    <div class="container">
                        @if (_settings.ShowPrimaryIncomeSource)
                        {
                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="ddlPrimaryIncomeSource" HelpText="Select Primary Income Source" ResourceKey="lblPrimaryIncomeSource">Primary Income Source:</Label>
                                <div class="col-sm-9">
                                    <select id="ddlPrimaryIncomeSource" class="form-select" @bind="_client.PrimaryIncomeSource" required="@IsPrimaryIncomeSourceRequired">
                                        <option value=""></option>
                                        @foreach (var src in _primaryIncomeSourceOptions)
                                        {
                                            <option value="@src">@src</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="cblTrueFalseQuestions" HelpText="Select all program questions that apply to this client" ResourceKey="lblTrueFalseQuestions">Check All That Apply:</Label>
                            <div class="col-sm-9">
                                <ul id="cblTrueFalseQuestions" class="myGroupCheckBox">
                                    @foreach (var question in _trueFalseQuestionOptions)
                                    {
                                        var qKey = question;
                                        <li>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="@($"tf_{qKey}")" checked="@GetTfAnswer(qKey)" @onchange="@(e => SetTfAnswer(qKey, (bool)(e.Value ?? false)))" />
                                                <label class="form-check-label" for="@($"tf_{qKey}")">@qKey</label>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="ddlCaseWorker" HelpText="Select Interviewer / CaseWorker" ResourceKey="lblCaseWorker">Interviewer:</Label>
                            <div class="col-sm-9">
                                <select id="ddlCaseWorker" class="form-select" @bind="_caseWorkerIdString" required="@_settings.ShowRequiredFields">
                                    <option value="">Select</option>
                                    @foreach (var cw in _caseWorkers)
                                    {
                                        <option value="@cw.UserId.ToString()">@cw.DisplayName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        @if (_settings.ShowDisabilities)
                        {
                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="cblDisability" HelpText="Select all disabilities that apply" ResourceKey="lblDisability">Disabilities:</Label>
                                <div class="col-sm-9">
                                    <ul id="cblDisability" class="myGroupCheckBox">
                                        @foreach (var dis in _disabilityOptions)
                                        {
                                            var dKey = dis;
                                            <li>
                                                <div class="form-check">
                                                    <input type="checkbox" class="form-check-input" id="@($"dis_{dKey}")" checked="@HasDisability(dKey)" @onchange="@(e => ToggleDisability(dKey, (bool)(e.Value ?? false)))" />
                                                    <label class="form-check-label" for="@($"dis_{dKey}")">@dKey</label>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="cbxSubjectToReview" HelpText="Flag this client record for supervisor review" ResourceKey="lblSubjectToReview">Subject to Review:</Label>
                            <div class="col-sm-9">
                                <input id="cbxSubjectToReview" type="checkbox" class="form-check-input" @bind="_client.SubjectToReview" />
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="txtClientNote" HelpText="Notes regarding this client" ResourceKey="lblClientNote">Client Note:</Label>
                            <div class="col-sm-9">
                                <textarea id="txtClientNote" class="form-control" rows="4" maxlength="1000" @bind="_client.ClientNote"></textarea>
                            </div>
                        </div>

                        @if (_settings.ShowClientIdCard)
                        {
                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="txtClientIdCard" HelpText="Client ID Card Number" ResourceKey="lblClientIdCard">Client ID Card:</Label>
                                <div class="col-sm-9">
                                    <input id="txtClientIdCard" class="form-control" maxlength="50" @bind="_client.ClientIdCard" />
                                </div>
                            </div>
                        }

                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-3" For="cbxIsLocked" HelpText="When checked, visits cannot be added for this client" ResourceKey="lblIsLocked">Locked Account:</Label>
                            <div class="col-sm-9">
                                <input id="cbxIsLocked" type="checkbox" class="form-check-input" @bind="_isLockedBool" disabled="@(!_canDeleteRecord)" />
                            </div>
                        </div>

                        @if (_id > 0)
                        {
                            <div class="row mt-3">
                                <div class="col-12">
                                    <AuditInfo CreatedBy="@_client.CreatedBy" CreatedOn="@_client.CreatedOn" ModifiedBy="@_client.ModifiedBy" ModifiedOn="@_client.ModifiedOn" />
                                </div>
                            </div>
                        }
                    </div>
                </Section>
            </form>
        </TabPanel>

        <TabPanel Name="AFM" Heading="Household Members" ResourceKey="TabAFM">
            @if (_id <= 0)
            {
                <div class="alert alert-info">Please save the client record on the Client tab before adding household members.</div>
            }
            else
            {
                <div class="table-responsive mb-3">
                    <table class="table table-striped table-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Edit</th>
                                <th>Delete</th>
                                @if (_settings.ShowXmasToys)
                                {
                                    <th>Christmas Toys</th>
                                }
                                <th>First Name</th>
                                <th>M.I.</th>
                                <th>Last Name</th>
                                @if (_settings.ShowSuffix)
                                {
                                    <th>Suffix</th>
                                }
                                <th>DOB</th>
                                <th>Age</th>
                                <th>Gender</th>
                                @if (_settings.ShowEthnicity)
                                {
                                    <th>Ethnicity</th>
                                }
                                <th>Verified</th>
                                @if (_settings.ShowRelationshipToClient)
                                {
                                    <th>Relationship</th>
                                }
                                <th>Last Update</th>
                                <th>Updated By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_familyMembers.Count == 0)
                            {
                                <tr>
                                    <td colspan="15" class="text-center text-muted">No additional household members recorded.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var afm in _familyMembers)
                                {
                                    var age = CalculateAge(afm.ClAddFamMemDOB);
                                    <tr>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="@(() => EditFamilyMember(afm))">Edit</button>
                                        </td>
                                        <td>
                                            <ActionDialog Header="Delete Household Member" Message="Are you sure you want to delete this family member?" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-sm btn-outline-danger" OnClick="@(async () => await DeleteFamilyMember(afm.FBClientsAddFamMemId))" />
                                        </td>
                                        @if (_settings.ShowXmasToys)
                                        {
                                            <td>
                                                @if (age.HasValue && age.Value <= 16)
                                                {
                                                    <button type="button" class="btn btn-sm @(HasCurrentYearToys(afm.FBClientsAddFamMemId) ? "btn-success" : "btn-outline-secondary")" disabled="@(!afm.AFMDOBVerify)" title="@(afm.AFMDOBVerify ? "Manage Christmas Toys" : "Verify DOB first to enable Christmas Toys")" @onclick="@(() => OpenChristmasForm(afm))">
                                                        Toys @(HasCurrentYearToys(afm.FBClientsAddFamMemId) ? "(Verified)" : "")
                                                    </button>
                                                }
                                            </td>
                                        }
                                        <td>@afm.ClAddFamMemFirstName</td>
                                        <td>@afm.AFMMiddleInitial</td>
                                        <td>@afm.ClAddFamMemLastName</td>
                                        @if (_settings.ShowSuffix)
                                        {
                                            <td>@afm.AFMSuffix</td>
                                        }
                                        <td>@(afm.ClAddFamMemDOB?.ToString("MM/dd/yyyy"))</td>
                                        <td>@(age?.ToString() ?? "")</td>
