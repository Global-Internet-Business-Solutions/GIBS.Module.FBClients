                        }
                    </div>

                    <div class="row mb-2 align-items-center">
                        <Label Class="col-sm-3" For="ddlVisitServiceLocation" HelpText="Select Visit Service Location" ResourceKey="lblVisitServiceLocation">Service Location:</Label>
                        <div class="col-sm-9">
                            <select id="ddlVisitServiceLocation" class="form-select" @bind="_editingVisit.ServiceLocation">
                                @foreach (var loc in _serviceLocationOptions)
                                {
                                    <option value="@loc">@loc</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mb-2 align-items-center">
                        <Label Class="col-sm-3" For="txtVisitDate" HelpText="Enter Visit Date" ResourceKey="lblVisitDate">Visit Date:</Label>
                        <div class="col-sm-9">
                            <input id="txtVisitDate" type="date" class="form-control" @bind="_visitDateInput" />
                        </div>
                    </div>

