                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="txtClAddFamMemDOB" HelpText="Enter Birth Date" ResourceKey="lblClAddFamMemDOB">Birth Date:</Label>
                                <div class="col-sm-5">
                                    <input id="txtClAddFamMemDOB" type="date" class="form-control" @bind="_afmDobInput" required="@_settings.ShowRequiredFields" />
                                </div>
                                <div class="col-sm-4">
                                    <div class="form-check">
                                        <input id="cbxAFMDOBVerify" type="checkbox" class="form-check-input" @bind="_editingAfm.AFMDOBVerify" required="@_settings.ReqAFMVerified" />
                                        <label class="form-check-label" for="cbxAFMDOBVerify">Verified</label>
                                    </div>
