                                        <input id="txtXmasGift1" class="form-control" maxlength="50" placeholder="Gift 1" @bind="_xmasRecord.XmasGift1" />
                                    </div>
                                    <div class="col-sm-4">
                                        <input id="txtXmasGift1Size" class="form-control" maxlength="50" placeholder="Gift 1 Size" @bind="_xmasRecord.XmasGift1Size" />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label fw-bold" for="txtXmasGift2">Gift 2 / Size:</label>
                                    <div class="col-sm-5">
                                        <input id="txtXmasGift2" class="form-control" maxlength="50" placeholder="Gift 2" @bind="_xmasRecord.XmasGift2" />
                                    </div>
                                    <div class="col-sm-4">
                                        <input id="txtXmasGift2Size" class="form-control" maxlength="50" placeholder="Gift 2 Size" @bind="_xmasRecord.XmasGift2Size" />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label fw-bold" for="txtXmasGiftRecordID">Gift Record ID:</label>
                                    <div class="col-sm-9">
                                        <input id="txtXmasGiftRecordID" class="form-control" maxlength="40" @bind="_xmasRecord.XmasGiftRecordID" />
                                    </div>
                                </div>
                            }

                            <div class="row mb-2 align-items-center">
                                <label class="col-sm-3 col-form-label fw-bold" for="txtXmasNotes">Notes:</label>
                                <div class="col-sm-9">
                                    <textarea id="txtXmasNotes" class="form-control" rows="2" maxlength="500" @bind="_xmasRecord.XmasNotes"></textarea>
                                </div>
                            </div>

                            <div class="row mb-2 align-items-center">
                                <label class="col-sm-3 col-form-label fw-bold" for="cbxBikeRaffle">Enter Bike Raffle:</label>
                                <div class="col-sm-9">
                                    <input id="cbxBikeRaffle" type="checkbox" class="form-check-input me-2" @bind="_xmasBikeRaffleBool" disabled="@_xmasBikeRaffleDisabled" />
