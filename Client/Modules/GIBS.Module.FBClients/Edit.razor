    private async Task SaveVisit()
    {
        try
        {
            if (_client.IsLocked == true)
            {
                AddModuleMessage("THIS ACCOUNT IS LOCKED - YOU CANNOT ADD A VISIT!", MessageType.Error);
                return;
            }

            _editingVisit.FBClientsId = _id;
            _editingVisit.ServiceLocation ??= "Pantry";

            if (_editingVisit.VisitId > 0)
            {
                await ClientFBClientsService.UpdateFBClientsVisitAsync(_editingVisit, ModuleState.ModuleId);
            }
            else
            {
                int count = (string.Equals(_client.ClientType, "Pallet", StringComparison.OrdinalIgnoreCase) && _repeatInsertCount > 1)
                    ? _repeatInsertCount
                    : 1;
                for (int i = 0; i < count; i++)
                {
                    await ClientFBClientsService.AddFBClientsVisitAsync(new FBClientsVisits
                    {
                        FBClientsId = _id,
                        VisitDate = _editingVisit.VisitDate,
                        VisitNumBags = _editingVisit.VisitNumBags,
                        VisitNotes = _editingVisit.VisitNotes,
                        ServiceLocation = _editingVisit.ServiceLocation,
                        OrderStatusCode = _editingVisit.OrderStatusCode ?? 0
                    }, ModuleState.ModuleId);
                }
            }

            _visits = await ClientFBClientsService.GetFBClientsVisitsAsync(_id, ModuleState.ModuleId) ?? new();
            RecalculateHeaderAndValidation();
            ResetVisitForm();
            AddModuleMessage("Visit saved.", MessageType.Success);
