                                <button type="button" class="btn btn-outline-secondary" @onclick="ResetFamilyMemberForm">Clear</button>
                            </div>

                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="txtClAddFamMemFirstName" HelpText="Enter Family Member First Name" ResourceKey="lblClAddFamMemFirstName">First Name:</Label>
                                <div class="col-sm-9">
                                    <input id="txtClAddFamMemFirstName" class="form-control" maxlength="50" @bind="_editingAfm.ClAddFamMemFirstName" required />
                                </div>
                            </div>

                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="txtAFMMiddleInitial" HelpText="Enter Middle Name or Initial" ResourceKey="lblAFMMiddleInitial">Middle Name/Initial:</Label>
                                <div class="col-sm-9">
                                    <input id="txtAFMMiddleInitial" class="form-control" maxlength="15" @bind="_editingAfm.AFMMiddleInitial" />
                                </div>
                            </div>

                            <div class="row mb-2 align-items-center">
                                <Label Class="col-sm-3" For="txtClAddFamMemLastName" HelpText="Enter Family Member Last Name" ResourceKey="lblClAddFamMemLastName">Last Name:</Label>
                                <div class="col-sm-9">
                                    <input id="txtClAddFamMemLastName" class="form-control" maxlength="50" @bind="_editingAfm.ClAddFamMemLastName" required />
