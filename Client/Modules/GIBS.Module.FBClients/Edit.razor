    // Christmas Toys
    private int GetConfiguredXmasYear()
    {
        return int.TryParse(_settings.XmasToysYear, out var yr) && yr > 2000 ? yr : DateTime.Today.Year;
    }

    private bool HasCurrentYearToys(int afmId)
    {
        int yr = GetConfiguredXmasYear();
        return _christmases.Any(x => x.FBClientsAddFamMemId == afmId && x.xMasYear == yr && x.VerifiedToys == true);
    }

    private bool IsChildAgeInXmasSizeRange(DateOnly? dob)
    {
        var age = CalculateAge(dob);
        if (!age.HasValue)
        {
            return false;
        }
        if (string.IsNullOrWhiteSpace(_settings.XmasRequireSizeAgeRange))
        {
            return true;
        }
        var allowedAges = _settings.XmasRequireSizeAgeRange
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => int.TryParse(s, out var a) ? a : -1)
            .ToHashSet();
        return allowedAges.Contains(age.Value);
    }

    private void OpenChristmasForm(FBClientsAddFamMem afm)
    {
        _selectedXmasAfm = afm;
        int currentYear = GetConfiguredXmasYear();
        _afmChristmasHistory = _christmases
            .Where(x => x.FBClientsAddFamMemId == afm.FBClientsAddFamMemId)
            .OrderByDescending(x => x.xMasYear)
            .ToList();

        var existingCurrentYear = _afmChristmasHistory.FirstOrDefault(x => x.xMasYear == currentYear);
        if (existingCurrentYear != null)
        {
            _xmasRecord = new FBClientsChristmas
            {
                xMasId = existingCurrentYear.xMasId,
                FBClientsId = existingCurrentYear.FBClientsId,
                FBClientsAddFamMemId = existingCurrentYear.FBClientsAddFamMemId,
                xMasYear = existingCurrentYear.xMasYear,
                Sizes = existingCurrentYear.Sizes,
                BikeRaffle = existingCurrentYear.BikeRaffle,
                BikeAwardedDate = existingCurrentYear.BikeAwardedDate,
                WantsToys = existingCurrentYear.WantsToys,
                VerifiedToys = existingCurrentYear.VerifiedToys,
                ReceivedToysDate = existingCurrentYear.ReceivedToysDate,
                XmasNotes = existingCurrentYear.XmasNotes,
                XmasGift1 = existingCurrentYear.XmasGift1,
                XmasGift2 = existingCurrentYear.XmasGift2,
                XmasGift1Size = existingCurrentYear.XmasGift1Size,
                XmasGift2Size = existingCurrentYear.XmasGift2Size,
                XmasGiftRecordID = existingCurrentYear.XmasGiftRecordID,
                CreatedBy = existingCurrentYear.CreatedBy,
                CreatedOn = existingCurrentYear.CreatedOn,
                ModifiedBy = existingCurrentYear.ModifiedBy,
                ModifiedOn = existingCurrentYear.ModifiedOn
            };
        }
        else
        {
            _xmasRecord = new FBClientsChristmas
            {
                FBClientsId = _id,
                FBClientsAddFamMemId = afm.FBClientsAddFamMemId,
                xMasYear = currentYear,
                WantsToys = true,
                VerifiedToys = true
            };
        }

        // Bike raffle eligibility check (age >= 9 and no bike won in past 5 years)
        var age = CalculateAge(afm.ClAddFamMemDOB) ?? 0;
        var recentBikeWin = _afmChristmasHistory.FirstOrDefault(x =>
            x.BikeAwardedDate.HasValue &&
            x.BikeAwardedDate.Value.Year >= currentYear - 5 &&
            x.xMasYear != currentYear);

        if (age < 9)
        {
            _xmasBikeRaffleDisabled = true;
            _xmasRecord.BikeRaffle = false;
            _xmasBikeNote = "Child must be at least 9 years old to enter the Bike Raffle.";
        }
        else if (recentBikeWin != null)
        {
            _xmasBikeRaffleDisabled = true;
            _xmasRecord.BikeRaffle = false;
            _xmasBikeNote = $"Bike was already awarded on {recentBikeWin.BikeAwardedDate:MM/dd/yyyy}.";
        }
        else
        {
            _xmasBikeRaffleDisabled = false;
            _xmasBikeNote = string.Empty;
        }

        _showChristmasForm = true;
    }

    private void CloseChristmasForm()
    {
        _showChristmasForm = false;
        _selectedXmasAfm = null;
        _xmasRecord = new();
        _afmChristmasHistory.Clear();
    }

