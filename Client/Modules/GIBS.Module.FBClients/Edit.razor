    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settingsDict = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            _settings = FBClientsSettings.FromDictionary(settingsDict);

            if (!string.IsNullOrWhiteSpace(_settings.FBState) && string.IsNullOrWhiteSpace(_client.ClientState))
            {
                _client.ClientState = _settings.FBState;
            }
            else if (string.IsNullOrWhiteSpace(_client.ClientState))
            {
                _client.ClientState = "MA";
            }

            _canDeleteRecord = UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin) ||
                               (!string.IsNullOrWhiteSpace(_settings.ClientManagerDeleteRecordRole) &&
                                UserSecurity.IsAuthorized(PageState.User, _settings.ClientManagerDeleteRecordRole));

            await LoadCaseWorkersAsync();

            if (PageState.QueryString.TryGetValue("TabFocus", out var tabFocus) && !string.IsNullOrWhiteSpace(tabFocus))
            {
                _activeTab = tabFocus;
            }
            else if (PageState.QueryString.TryGetValue("tab", out var tabParam) && !string.IsNullOrWhiteSpace(tabParam))
            {
                _activeTab = tabParam;
            }

            if (PageState.Action == "Edit" || PageState.QueryString.ContainsKey("id"))
            {
                if (PageState.QueryString.TryGetValue("id", out var idStr) && int.TryParse(idStr, out var parsedId) && parsedId > 0)
                {
                    _id = parsedId;
                    await LoadClientAndRelatedDataAsync();
                }
            }
            else
            {
                InitializeNewClientDefaults();
            }

            _initialized = true;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading FBClients {FBClientsId} {Error}", _id, ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    private void InitializeNewClientDefaults()
    {
        _client = new Models.FBClients
        {
            ModuleId = ModuleState.ModuleId,
            IsActive = true,
            IsLocked = false,
            ClientType = "Individual",
            ServiceLocation = _serviceLocationOptions.FirstOrDefault() ?? "Pantry",
            ClientState = !string.IsNullOrWhiteSpace(_settings.FBState) ? _settings.FBState : "MA",
            ClientLanguage = "en",
            PrimaryIncomeSource = string.Empty,
            LegacyCaseWorkerUserId = PageState.User?.UserId
        };
        _verificationAlerts = new List<string> { "Ready to insert a new record." };
    }

    private async Task LoadCaseWorkersAsync()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(_settings.ClientManagerUserRole))
            {
                var userRoles = await UserRoleService.GetUserRolesAsync(PageState.Site.SiteId, _settings.ClientManagerUserRole);
                if (userRoles != null)
                {
                    _caseWorkers = userRoles
                        .Where(ur => ur.User != null)
                        .Select(ur => ur.User)
                        .GroupBy(u => u.UserId)
                        .Select(g => g.First())
                        .OrderBy(u => u.DisplayName)
                        .ToList();
                }
            }
            if (_caseWorkers.Count == 0 && PageState.User != null)
            {
                _caseWorkers.Add(PageState.User);
            }
        }
        catch
        {
            if (PageState.User != null && _caseWorkers.Count == 0)
            {
                _caseWorkers.Add(PageState.User);
            }
        }
    }

    private async Task LoadClientAndRelatedDataAsync()
    {
        var loadedClient = await ClientFBClientsService.GetFBClientsAsync(_id, ModuleState.ModuleId);
        if (loadedClient == null)
        {
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
            return;
        }

        _client = loadedClient;
        if (string.IsNullOrWhiteSpace(_client.ClientType))
        {
            _client.ClientType = "Individual";
        }
        if (string.IsNullOrWhiteSpace(_client.ServiceLocation))
        {
            _client.ServiceLocation = _serviceLocationOptions.FirstOrDefault() ?? "Pantry";
        }
        if (!string.IsNullOrWhiteSpace(_client.ClientCity) && !_townOptions.Contains(_client.ClientCity, StringComparer.OrdinalIgnoreCase) && !string.Equals(_client.ClientCity, "OTHER", StringComparison.OrdinalIgnoreCase))
        {
            _townOptions.Add(_client.ClientCity);
        }

        _selectedDisabilities.Clear();
        if (!string.IsNullOrWhiteSpace(_client.Disability))
        {
            foreach (var part in _client.Disability.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                _selectedDisabilities.Add(part);
            }
        }

        _familyMembers = await ClientFBClientsService.GetFBClientsAddFamMemsAsync(_id, ModuleState.ModuleId) ?? new();
        _incomeAndExpenses = await ClientFBClientsService.GetFBClientsIncomeAndExpensesAsync(_id, ModuleState.ModuleId) ?? new();
        _visits = await ClientFBClientsService.GetFBClientsVisitsAsync(_id, ModuleState.ModuleId) ?? new();
        _christmases = await ClientFBClientsService.GetFBClientsChristmasesAsync(_id, ModuleState.ModuleId) ?? new();
        _tfQuestions = await ClientFBClientsService.GetFBClientsTrueFalseQuestionsAsync(_id, ModuleState.ModuleId) ?? new();
        _idPhotos = await ClientFBClientsService.GetFBClientsIDPhotosAsync(_id, ModuleState.ModuleId) ?? new();

        _tfQuestionAnswers.Clear();
        foreach (var q in _tfQuestions)
        {
            _tfQuestionAnswers[q.TfQuestion] = q.TfAnswer;
            if (!_trueFalseQuestionOptions.Contains(q.TfQuestion, StringComparer.OrdinalIgnoreCase))
            {
                _trueFalseQuestionOptions.Add(q.TfQuestion);
            }
        }

        // Photo resolution (IDPhoto first, fallback to ClientPhoto)
        var photoBytes = _idPhotos.FirstOrDefault()?.IDPhoto ?? _client.ClientPhoto;
        _clientPhotoDataUrl = (photoBytes != null && photoBytes.Length > 0)
            ? $"data:image/jpeg;base64,{Convert.ToBase64String(photoBytes)}"
            : string.Empty;

        RecalculateHeaderAndValidation();
        ResetFamilyMemberForm();
        ResetIncomeExpenseForm();
        ResetVisitForm();
    }

    private void RecalculateHeaderAndValidation()
    {
        _householdTotal = 1 + _familyMembers.Count;
        _qualifiesForBags = CalculateBagQualification();

        // Visits & Stop/Go Light
        var lastVisit = _visits.OrderByDescending(v => v.VisitDate).ThenByDescending(v => v.VisitId).FirstOrDefault();
        int daysWindow = int.TryParse(_settings.DaysToValidVisit, out var parsedWindow) && parsedWindow > 0 ? parsedWindow : 1;
        if (lastVisit == null)
        {
            _visitEligible = true;
            _lastVisitSummary = "Last Visit: Never";
        }
        else
        {
            var daysAgo = DateOnly.FromDateTime(DateTime.Today).DayNumber - lastVisit.VisitDate.DayNumber;
            _visitEligible = daysAgo >= daysWindow;
            _lastVisitSummary = $"Last Visit: {lastVisit.VisitDate:MM/dd/yyyy} ({daysAgo} Days Ago)";
        }

        // Age Groups (matching fn_GIBS_FBClients_GetAgeGroup)
        int seniors = 0, adults = 0, children = 0, noDob = 0;
        var allDobs = new List<DateOnly?> { _client.ClientDOB };
        allDobs.AddRange(_familyMembers.Select(m => m.ClAddFamMemDOB));
        foreach (var dob in allDobs)
        {
            var age = CalculateAge(dob);
            if (!age.HasValue || age.Value <= 0)
            {
                noDob++;
            }
            else if (age.Value <= 17)
            {
                children++;
            }
            else if (age.Value <= 64)
            {
                adults++;
            }
            else
            {
                seniors++;
            }
        }
        _ageGroupsSummary = $"Seniors (65+): {seniors} | Adults (18-64): {adults} | Children (0-17): {children}" +
                            (noDob > 0 ? $" | No DOB: {noDob}" : string.Empty);

        // Income & Expense totals
        _totalMonthlyIncome = _incomeAndExpenses
            .Where(x => string.Equals(x.IeType, "IN", StringComparison.OrdinalIgnoreCase))
            .Sum(x => x.IeAmount ?? 0m);
        _totalMonthlyExpenses = _incomeAndExpenses
            .Where(x => string.Equals(x.IeType, "EX", StringComparison.OrdinalIgnoreCase))
            .Sum(x => x.IeAmount ?? 0m);
        _netIncomeExpense = _totalMonthlyIncome - _totalMonthlyExpenses;

        // Verification warnings (matching EditClient.ascx.cs)
        _verificationAlerts.Clear();
        if (_id > 0)
        {
            var oneYearAgo = DateOnly.FromDateTime(DateTime.Today.AddDays(-365));
            if (!_client.ClientDOBVerify)
            {
                _verificationAlerts.Add("Verify Client Record (see checkbox)");
            }
            if (!_client.ClientDOB.HasValue)
            {
                _verificationAlerts.Add("Missing Client Date of Birth");
            }
            if (!_client.ClientVerifyDate.HasValue || _client.ClientVerifyDate.Value < oneYearAgo)
            {
                _verificationAlerts.Add("Client Verified Date Has Expired (greater than 1 year)");
            }
            if (!_client.ClientAddressVerify)
            {
                _verificationAlerts.Add("Verify Client Address (see checkbox)");
            }
            if (!_client.ClientAddressVerifyDate.HasValue || _client.ClientAddressVerifyDate.Value < oneYearAgo)
            {
                _verificationAlerts.Add("Client Address Verified Date Has Expired (greater than 1 year)");
            }
            if (_familyMembers.Any(m => !m.ClAddFamMemDOB.HasValue))
            {
                _verificationAlerts.Add("Family Member Missing Date of Birth");
            }
            if (_familyMembers.Any(m => !m.AFMDOBVerify))
            {
                _verificationAlerts.Add("Unverified Family Member");
            }
            if (_settings.ReqEthnicity && _familyMembers.Any(m => string.IsNullOrWhiteSpace(m.AFMEthnicity)))
            {
                _verificationAlerts.Add("Missing Family Member Ethnicity");
            }
        }
    }

    private int CalculateBagQualification()
    {
        if (_client.OneBagOnly)
        {
            return 1;
        }
        if (string.Equals(_client.ClientType, "Group Home", StringComparison.OrdinalIgnoreCase))
        {
            return int.TryParse(_settings.GroupHomeBagAllowance, out var ghBags) && ghBags > 0 ? ghBags : 1;
        }

        int household = Math.Max(1, _householdTotal);
        if (!string.IsNullOrWhiteSpace(_settings.BagAllowance))
        {
            int fallbackBags = 1;
            foreach (var pair in _settings.BagAllowance.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                var kv = pair.Split('=', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                if (kv.Length == 2 && int.TryParse(kv[0], out var size) && int.TryParse(kv[1], out var bags))
                {
                    fallbackBags = bags;
                    if (size == household)
                    {
                        return bags;
                    }
                }
            }
            return fallbackBags;
        }
        return 1;
    }

    private string GetClientHeaderBlock()
    {
        var fullName = string.Join(" ", new[] { _client.ClientFirstName, _client.ClientMiddleInitial, _client.ClientLastName, _client.ClientSuffix }
            .Where(s => !string.IsNullOrWhiteSpace(s)));
        var unitPart = !string.IsNullOrWhiteSpace(_client.ClientUnit) ? $" {_client.ClientUnit}" : string.Empty;
        var townOrCity = !string.IsNullOrWhiteSpace(_client.ClientTown) ? _client.ClientTown : _client.ClientCity;
        var addressLine = $"{_client.ClientAddress}{unitPart}, {townOrCity}, {_client.ClientState} {_client.ClientZipCode}".Trim(' ', ',')
        ;
        var phonePrefix = (!string.IsNullOrWhiteSpace(_client.ClientPhoneType) && _client.ClientPhoneType != "0")
            ? $"{_client.ClientPhoneType} Phone: "
            : "Phone: ";
        var phoneLine = !string.IsNullOrWhiteSpace(_client.ClientPhone) ? $" | {phonePrefix}{_client.ClientPhone}" : string.Empty;
        var age = CalculateAge(_client.ClientDOB);
        var dobLine = _client.ClientDOB.HasValue ? $" | DOB: {_client.ClientDOB:MM/dd/yyyy} (Age: {age})" : string.Empty;
        var entryDate = _client.LegacyCreatedOnDate ?? (_client.CreatedOn != default ? _client.CreatedOn : DateTime.Today);
        return $"{fullName} — {addressLine}{phoneLine}{dobLine} | Entry Date: {entryDate:MM/dd/yyyy}";
    }

    private static int? CalculateAge(DateOnly? dob)
    {
        if (!dob.HasValue)
        {
            return null;
        }
        var today = DateOnly.FromDateTime(DateTime.Today);
        int age = today.Year - dob.Value.Year;
        if (today.Month < dob.Value.Month || (today.Month == dob.Value.Month && today.Day < dob.Value.Day))
        {
            age--;
        }
        return age;
    }

    private string GetLastNameLabel()
    {
        if (string.Equals(_client.ClientType, "Pallet", StringComparison.OrdinalIgnoreCase))
        {
            return "Pallet Name:";
        }
        if (string.Equals(_client.ClientType, "Group Home", StringComparison.OrdinalIgnoreCase))
        {
            return "Group Home Name:";
        }
        return Localizer["lblClientLastName.Text"];
