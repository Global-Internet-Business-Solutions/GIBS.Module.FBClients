@code {
    private static readonly HashSet<string> ExcludedDefaultRoles = new(StringComparer.OrdinalIgnoreCase)
    {
        RoleNames.Admin,
        RoleNames.Registered,
        RoleNames.Everyone,
        RoleNames.Unauthenticated,
        "Subscribers"
    };

    private string resourceType = "GIBS.Module.FBClients.Settings, GIBS.Module.FBClients.Client.Oqtane";
    public override string Title => "FBClients Settings";

    private bool _initialized;
    private FBClientsSettings _settings = new();
    private List<Folder> _folders = new();
    private int _rootFolderId;
    private List<string> _availableRoles = new();
    private RichTextEditor _toyTicketEditor;
    private RichTextEditor _incomeEligibilityGuidelinesEditor;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rootFolder = await FolderService.GetFolderAsync(PageState.Site.SiteId, "");
            if (rootFolder != null)
            {
                _rootFolderId = rootFolder.FolderId;
            }

            _folders = await FolderService.GetFoldersAsync(PageState.Site.SiteId) ?? new List<Folder>();

            Dictionary<string, string> settings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            _settings = FBClientsSettings.FromDictionary(settings);

            if (string.IsNullOrWhiteSpace(_settings.IDCardImagePath) && _rootFolderId > 0)
            {
                _settings.IDCardImagePath = _rootFolderId.ToString();
            }

            var roles = await RoleService.GetRolesAsync(PageState.Site.SiteId);
            if (roles != null)
            {
                _availableRoles = roles
                    .Where(role => !string.IsNullOrWhiteSpace(role.Name) && !ExcludedDefaultRoles.Contains(role.Name))
                    .Select(role => role.Name)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }

            _initialized = true;
        }
        catch (Exception ex)
        {
            AddModuleMessage(ex.Message, MessageType.Error);
        }
    }

    public async Task UpdateSettings()
    {
        try
        {
            if (_toyTicketEditor != null)
            {
                _settings.ToyTicketContent = await _toyTicketEditor.GetHtml();
            }

            if (_incomeEligibilityGuidelinesEditor != null)
            {
                _settings.IncomeEligibilityGuidelines = await _incomeEligibilityGuidelinesEditor.GetHtml();
            }

            var settings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            _settings.ApplyToDictionary(settings);
            await SettingService.UpdateModuleSettingsAsync(settings, ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            AddModuleMessage(ex.Message, MessageType.Error);
        }
    }

    private IEnumerable<string> GetSelectableRoles(string currentRole)
    {
        if (!string.IsNullOrWhiteSpace(currentRole) && !_availableRoles.Contains(currentRole, StringComparer.OrdinalIgnoreCase))
        {
            return new[] { currentRole }.Concat(_availableRoles);
        }

        return _availableRoles;
    }
}

